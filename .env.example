# 本地开发：复制为 .env.development
#   cp .env.example .env.development
# 生产构建：另存为 .env.root，改用下方「生产」段变量（或见 deploy-edgeone.yml）
VITE_BASE=/developerprofiles/
VITE_STUDENT_DDL_URL=http://127.0.0.1:3001/
VITE_STARTRAIL_NOTES_URL=http://127.0.0.1:3002/
VITE_TRAVELER_WEATHER_URL=http://127.0.0.1:3003/
VITE_TRAVELER_AI_URL=http://127.0.0.1:3004/

